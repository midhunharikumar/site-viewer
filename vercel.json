{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/search.js": {
      "maxDuration": 60
    },
    "api/cron/newsletter.mjs": {
      "maxDuration": 60,
      "includeFiles": "{index.html,data/**}"
    },
    "api/cron/alerts.mjs": {
      "maxDuration": 60,
      "includeFiles": "{index.html,data/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/newsletter",
      "schedule": "30 2 * * 6"
    },
    {
      "path": "/api/cron/alerts",
      "schedule": "45 2 * * 6"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "interest-cohort=()"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/og-cover.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        }
      ]
    },
    {
      "source": "/(l|p|areas|projects|heat|compare|builders|launches)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/locality/:slug",
      "destination": "/l/:slug",
      "permanent": true
    },
    {
      "source": "/project/:slug",
      "destination": "/p/:slug",
      "permanent": true
    },
    {
      "source": "/areas/:slug",
      "destination": "/l/:slug",
      "permanent": true
    }
  ],
  "regions": [
    "bom1"
  ]
}
