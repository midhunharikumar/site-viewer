# Copy to .env.local (gitignored) and fill in. Do NOT commit real values.

# --- AI project search (api/search.js) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_TOOL_MODEL=google/gemini-3.1-flash-lite

# --- Apps Script /exec URL for WRITING rows (lead capture + cron 'alert-sent' state) ---
SHEET_WEBHOOK_URL=

# --- Vercel Cron auth: same secret in code + Vercel env (openssl rand -hex 32) ---
CRON_SECRET=

# --- Mailgun: send scripts + cron (npm run alerts / npm run newsletter) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mail.deepsilabs.com
MAILGUN_FROM=noreply@mail.deepsilabs.com
MAILGUN_TO=info@deepsilabs.com

# --- Read subscribers back from the Google Sheet (Apps Script doGet, see SETUP-email.md) ---
# Leave blank to use the --csv <file> fallback instead.
SHEET_READ_URL=
SHEET_READ_TOKEN=
